<Window x:Class="Luma.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Luma.Controls" xmlns:themes="clr-namespace:Luma.Themes"
        Title="Luma" Icon="/Assets/Luma.ico" Style="{StaticResource {x:Type Window}}" Width="940" Height="730" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type themes:AccentOption}"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Hex}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate>
    <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="#2A2A2D" /><Setter Property="Margin" Value="0,13" /></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#7F7F89" /><Setter Property="Margin" Value="0,23,0,14" /></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}" TextOptions.TextFormattingMode="Display">
    <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border x:Name="TitleBar" Background="Transparent"><Grid>
      <StackPanel Orientation="Horizontal" Margin="23,0" VerticalAlignment="Center"><Image Source="{StaticResource BrandSymbol}" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="luma" FontSize="13" Foreground="#CBCBD0" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource QuietButton}" Width="37" Height="36" Click="Minimize_Click" ToolTip="Küçült" AutomationProperties.Name="Küçült"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE921;" /></Button>
        <Button x:Name="CloseButton" Style="{StaticResource QuietButton}" Width="37" Height="36" Click="Close_Click" ToolTip="Sistem tepsisine gizle" AutomationProperties.Name="Sistem tepsisine gizle"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8BB;" /></Button>
      </StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="424" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border BorderBrush="#29292C" BorderThickness="0,0,1,0" Background="#121214">
        <Grid Margin="26,26,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Küçük. Akıcı. Yerinde." FontSize="22" FontWeight="SemiBold" /><TextBlock Text="İhtiyaç duyduğunda görünür, sonra çekilir." Foreground="#83838E" FontSize="11" Margin="0,8,0,0" /></StackPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="ÖRNEK GÖRÜNÜM" FontSize="9" Foreground="#73737F" Margin="2,0,0,12" />
            <Border Height="56" CornerRadius="10" Background="#232325" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="14,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="17" />
                <controls:SmoothSlider Style="{StaticResource FluidSlider}" Grid.Column="1" Value="40" IsHitTestVisible="False" Focusable="False" Margin="12,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="40" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border x:Name="MediaPreviewCard" Height="222" Margin="0,8,0,0" CornerRadius="10" Background="#222224" BorderBrush="#1EFFFFFF" BorderThickness="1">
              <Grid ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,370,220" RadiusX="9" RadiusY="9" /></Grid.Clip>
                <Image x:Name="PreviewBackdrop" Stretch="UniformToFill" Opacity="0.55"><Image.Effect><BlurEffect Radius="18" /></Image.Effect></Image><Border Background="#90222224" />
                <Grid Margin="17,15"><Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Önizleme" FontSize="10" Foreground="#C8C8CC" /></StackPanel><TextBlock Text="Blue hour" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Luma Sessions" FontSize="11" Foreground="#CDCDD2" Margin="0,4,0,0" /></StackPanel>
                    <Border x:Name="PreviewCover" Grid.Column="1" CornerRadius="6" />
                  </Grid>
                  <Grid Grid.Row="1" Margin="0,17,0,0"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="12" /></Grid.RowDefinitions><controls:SmoothSlider Style="{StaticResource TimelineSlider}" Value="32" IsHitTestVisible="False" Focusable="False" /><TextBlock Grid.Row="1" Text="1:12" FontSize="9" Foreground="#ADADB5" /><TextBlock Grid.Row="1" Text="3:42" FontSize="9" Foreground="#ADADB5" HorizontalAlignment="Right" /></Grid>
                  <Grid Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Opacity="0.45" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE892;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,25,0" /><Border Width="34" Height="34" CornerRadius="17" Background="#18FFFFFF"><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="15" /></Border><TextBlock Text="&#xE893;" Style="{StaticResource Icon}" FontSize="16" Margin="25,0,0,0" /></StackPanel><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Right" Opacity="0.45" /></Grid>
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
          <Grid Grid.Row="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#8CC9A0" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock x:Name="ServiceStatus" Text="Arka planda hazır" FontSize="10" Foreground="#8E9D92" /></StackPanel><TextBlock Text="0.5.1" FontSize="10" Foreground="#61616D" HorizontalAlignment="Right" /></Grid>
        </Grid>
      </Border>
      <ScrollViewer x:Name="PreferencesScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="27,25,26,24">
          <TextBlock Text="Tercihler" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Masaüstüne uyacak birkaç küçük ayar." FontSize="11" Foreground="#85858F" Margin="0,7,0,0" />
          <TextBlock Text="GÖSTERGELER" Style="{StaticResource SectionLabel}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Ses tuşları" Style="{StaticResource RowTitle}" /><TextBlock Text="Ses açma, kısma ve sessize alma." FontSize="10" Foreground="#85858F" /></StackPanel><CheckBox x:Name="VolumeToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Ses tuşlarını Luma ile kullan" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Medya kartı" Style="{StaticResource RowTitle}" /><TextBlock Text="Çalan parça, albüm kapağı ve oynatma kontrolleri." FontSize="10" Foreground="#85858F" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="MediaToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Medya kartını göster" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Klavye kilitleri" Style="{StaticResource RowTitle}" /><TextBlock Text="Caps Lock, Num Lock ve Scroll Lock." FontSize="10" Foreground="#85858F" /></StackPanel><CheckBox x:Name="LocksToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Klavye kilitlerini göster" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Diğer ses değişiklikleri" Style="{StaticResource RowTitle}" /><TextBlock Text="Ses başka bir yerden değiştirildiğinde de göster." FontSize="10" Foreground="#85858F" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="ObserveToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Diğer ses değişikliklerini göster" /></Grid>
          <TextBlock Text="EKRAN PARLAKLIĞI" Style="{StaticResource SectionLabel}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Parlaklık göstergesi" Style="{StaticResource RowTitle}" /><TextBlock Text="Fn tuşlarıyla veya Windows'tan değiştirildiğinde göster." FontSize="10" Foreground="#85858F" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="BrightnessToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Parlaklık değişikliklerini göster" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Windows parlaklık panelini gizle" Style="{StaticResource RowTitle}" /><TextBlock Text="Luma gösterirken alttaki ikinci paneli gizle." FontSize="10" Foreground="#85858F" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="NativeBrightnessToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Windows parlaklık panelini gizle" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="Dahili ekran" FontSize="12" VerticalAlignment="Center" /><Slider x:Name="DisplayBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsEnabled="False" ValueChanged="DisplayBrightness_Changed" AutomationProperties.Name="Laptop ekran parlaklığı" /><TextBlock x:Name="DisplayBrightnessText" Grid.Column="2" Text="—" FontSize="10" Foreground="#92929D" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
          <TextBlock x:Name="BrightnessStatusText" Text="Parlaklık desteği kontrol ediliyor…" FontSize="10" Foreground="#85858F" TextWrapping="Wrap" Margin="0,9,0,0" />
          <TextBlock Text="GÖRÜNÜM" Style="{StaticResource SectionLabel}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="154" /></Grid.ColumnDefinitions><TextBlock Text="Vurgu rengi" FontSize="12" VerticalAlignment="Center" /><ComboBox x:Name="AccentCombo" Grid.Column="1" SelectionChanged="Accent_Changed" AutomationProperties.Name="Vurgu rengi" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="154" /></Grid.ColumnDefinitions><TextBlock Text="Ekrandaki konum" FontSize="12" VerticalAlignment="Center" /><ComboBox x:Name="PositionCombo" Grid.Column="1" SelectionChanged="Position_Changed" AutomationProperties.Name="Ekrandaki konum"><ComboBoxItem Content="Alt orta" Tag="BottomCenter" /><ComboBoxItem Content="Üst orta" Tag="TopCenter" /><ComboBoxItem Content="Sağ üst" Tag="TopRight" /><ComboBoxItem Content="Sağ alt" Tag="BottomRight" /><ComboBoxItem Content="Sol üst" Tag="TopLeft" /><ComboBoxItem Content="Sol alt" Tag="BottomLeft" /></ComboBox></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Text="Gösterilecek ekran" FontSize="12" VerticalAlignment="Center" /><ComboBox x:Name="MonitorCombo" Grid.Column="1" SelectionChanged="Monitor_Changed" DropDownOpened="Monitor_Opened" AutomationProperties.Name="Göstergenin açılacağı monitör" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="Gösterge boyutu" FontSize="12" VerticalAlignment="Center" /><Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.75" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Scale_Changed" AutomationProperties.Name="Gösterge boyutu" /><TextBlock x:Name="ScaleText" Grid.Column="2" FontSize="10" Foreground="#92929D" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="Ekranda kalma süresi" FontSize="12" VerticalAlignment="Center" /><Slider x:Name="DurationSlider" Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Duration_Changed" AutomationProperties.Name="Ekranda kalma süresi" /><TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10" Foreground="#92929D" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="Ses adımı" FontSize="12" VerticalAlignment="Center" /><Slider x:Name="StepSlider" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Step_Changed" AutomationProperties.Name="Her basışta ses değişimi" /><TextBlock x:Name="StepText" Grid.Column="2" FontSize="10" Foreground="#92929D" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><TextBlock Text="Yumuşak geçişler" FontSize="12" VerticalAlignment="Center" /><CheckBox x:Name="AnimationsToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Yumuşak animasyonlar" /></Grid>
          <Border Style="{StaticResource Divider}" />
          <Grid><TextBlock Text="Albüm kapağını arka plana yansıt" FontSize="12" VerticalAlignment="Center" /><CheckBox x:Name="ArtworkToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Preference_Changed" Unchecked="Preference_Changed" AutomationProperties.Name="Albüm kapağını arka plana yansıt" /></Grid>
          <TextBlock Text="GÜNLÜK KULLANIM" Style="{StaticResource SectionLabel}" />
          <Grid><StackPanel Margin="0,0,58,0"><TextBlock Text="Windows ile başlat" Style="{StaticResource RowTitle}" /><TextBlock Text="Oturum açıldığında tepside hazır olsun." FontSize="10" Foreground="#85858F" /></StackPanel><CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="Startup_Changed" Unchecked="Startup_Changed" AutomationProperties.Name="Windows ile başlat" /></Grid>
          <TextBlock x:Name="FeedbackText" Text="Tercihlerin otomatik kaydedilir." FontSize="10" Foreground="#6F6F7C" TextWrapping="Wrap" Margin="0,24,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
