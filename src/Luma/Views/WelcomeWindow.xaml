<Window x:Class="Luma.Views.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma" Icon="/Assets/Luma.ico" Width="550" Height="610" MinHeight="580" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{DynamicResource BackgroundBrush}"><Grid Margin="32,25">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Image Source="{StaticResource BrandSymbol}" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,18"/><TextBlock Text="Luma'ya hoş geldin" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Masaüstünde küçük bir yer, günlük kullanımda büyük kolaylık." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock Text="Konumunu ve görünümünü seç. Bunları daha sonra ayarlardan değiştirebilirsin." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,22"/>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Dil / Language" VerticalAlignment="Center" FontSize="12"/><ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="Language_Changed"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="Deutsch" Tag="de"/><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="Italiano" Tag="it"/></ComboBox></Grid>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Tema" VerticalAlignment="Center" FontSize="12"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Theme_Changed"><ComboBoxItem Content="Koyu" Tag="Dark"/><ComboBoxItem Content="Açık" Tag="Light"/><ComboBoxItem Content="Windows ile aynı" Tag="System"/></ComboBox></Grid>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Ekrandaki konum" VerticalAlignment="Center" FontSize="12"/><ComboBox x:Name="PositionCombo" Grid.Column="1"><ComboBoxItem Content="Alt orta" Tag="BottomCenter"/><ComboBoxItem Content="Üst orta" Tag="TopCenter"/><ComboBoxItem Content="Sağ üst" Tag="TopRight"/><ComboBoxItem Content="Sağ alt" Tag="BottomRight"/><ComboBoxItem Content="Sol üst" Tag="TopLeft"/><ComboBoxItem Content="Sol alt" Tag="BottomLeft"/></ComboBox></Grid>
      <Grid><TextBlock Text="Windows ile başlat" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="Windows ile başlat"/></Grid>
      <TextBlock Text="Ses tuşlarına basınca Luma görünür. Ayarları açmak için tepsi simgesine bir kez tıkla." Style="{StaticResource MutedText}" FontSize="11" Margin="0,22,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/><Button x:Name="FinishButton" Content="Hazırım" Click="Finish_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"/></StackPanel>
  </Grid></Grid>
</Window>
