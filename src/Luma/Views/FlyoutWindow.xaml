<Window x:Class="Luma.Views.FlyoutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Luma.Controls"
        Title="Luma göstergesi" Style="{StaticResource {x:Type Window}}" Width="396" Height="80" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
  <Grid x:Name="CanvasRoot" Background="Transparent" ClipToBounds="True" TextOptions.TextFormattingMode="Display">
    <Grid Width="396" Height="310" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid.LayoutTransform><ScaleTransform x:Name="FlyoutTransform" /></Grid.LayoutTransform>
    <StackPanel x:Name="CardStack" Margin="12" VerticalAlignment="Top">
      <StackPanel.ContextMenu><ContextMenu><MenuItem Header="Luma ayarları" Click="Settings_Click" /><MenuItem x:Name="PinMenu" Header="Açık tut" IsCheckable="True" Click="Pin_Click" /><Separator /><MenuItem Header="Göstergeyi gizle" Click="Dismiss_Click" /></ContextMenu></StackPanel.ContextMenu>
      <Border x:Name="VolumeCard" Height="56" CornerRadius="10" Background="#EE232325" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="12,0" RenderTransformOrigin="0.5,0.5">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
          <Button x:Name="MuteButton" Style="{StaticResource QuietButton}" Click="Mute_Click" ToolTip="Sessize al / sesi aç" AutomationProperties.Name="Sessize al veya sesi aç"><TextBlock x:Name="VolumeIcon" Style="{StaticResource Icon}" FontSize="17" Text="&#xE767;" /></Button>
          <controls:SmoothSlider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FluidSlider}" Margin="12,0,10,0" Value="62" VerticalAlignment="Center" ValueChanged="Volume_Changed" SmallChange="2" LargeChange="10" AutomationProperties.Name="Ses düzeyi" />
          <TextBlock x:Name="ValueText" Grid.Column="2" Text="62" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="LockCard" Height="56" Visibility="Collapsed" CornerRadius="10" Background="#EE232325" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="18,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="LockIcon" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Left" />
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="Caps Lock" FontSize="13" VerticalAlignment="Center" />
          <TextBlock x:Name="LockStateText" Grid.Column="2" Text="Açık" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="MediaCard" Height="222" Margin="0,8,0,0" Visibility="Collapsed" CornerRadius="10" Background="#F0222224" BorderBrush="#1EFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.25">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" /></Border.Effect>
        <Grid ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,370,220" RadiusX="9" RadiusY="9" /></Grid.Clip>
          <Image x:Name="ArtworkBackdrop" Stretch="UniformToFill" Opacity="0.55" IsHitTestVisible="False"><Image.Effect><BlurEffect Radius="18" /></Image.Effect></Image>
          <Border Background="#90222224" IsHitTestVisible="False" />
          <Grid Margin="17,15"><Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock x:Name="AppNameText" Text="Medya" FontSize="10" Foreground="#C8C8CC" /></StackPanel>
                <TextBlock x:Name="TrackTitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Şarkı adı" />
                <TextBlock x:Name="ArtistText" FontSize="11" Foreground="#CDCDD2" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Text="Sanatçı" />
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="6" Background="#26FFFFFF"><Grid><TextBlock x:Name="ArtworkPlaceholder" Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="24" Foreground="#A4A4AD" /><Border x:Name="ArtworkCover" CornerRadius="6" /></Grid></Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,17,0,0"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="12" /></Grid.RowDefinitions>
              <controls:SmoothSlider x:Name="TimelineSlider" Style="{StaticResource TimelineSlider}" ValueChanged="Timeline_Changed" PreviewMouseLeftButtonUp="Timeline_Released" SmallChange="5" LargeChange="15" AutomationProperties.Name="Oynatma konumu" />
              <TextBlock x:Name="PositionText" Grid.Row="1" Text="0:00" FontSize="9" Foreground="#ADADB5" /><TextBlock x:Name="EndText" Grid.Row="1" Text="0:00" FontSize="9" Foreground="#ADADB5" HorizontalAlignment="Right" />
            </Grid>
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PreviousButton" Style="{StaticResource QuietButton}" Click="Previous_Click" ToolTip="Önceki" AutomationProperties.Name="Önceki parça" Margin="0,0,19,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="16" /></Button>
                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Click="Play_Click" ToolTip="Oynat / duraklat" AutomationProperties.Name="Oynat veya duraklat"><TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15" /></Button>
                <Button x:Name="NextButton" Style="{StaticResource QuietButton}" Click="Next_Click" ToolTip="Sonraki" AutomationProperties.Name="Sonraki parça" Margin="19,0,0,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="16" /></Button>
              </StackPanel>
              <Button x:Name="PinButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Pin_Click" ToolTip="Açık tut" AutomationProperties.Name="Göstergeyi açık tut" Opacity="0.45"><TextBlock x:Name="PinIcon" Style="{StaticResource Icon}" Text="&#xE718;" FontSize="13" /></Button>
              <Button x:Name="SourceButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="Source_Click" ContextMenuOpening="Sources_Opening" ToolTip="Medya kaynağını seç" AutomationProperties.Name="Medya kaynağını seç" Opacity="0.45" Visibility="Collapsed">
                <Button.ContextMenu><ContextMenu x:Name="SourceMenu" Style="{StaticResource SourceMenuStyle}" Opened="Sources_Opened" Closed="Sources_Closed" /></Button.ContextMenu>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="SourceArrowRotation" /></TextBlock.RenderTransform></TextBlock>
              </Button>
            </Grid>
          </Grid>
          <Border x:Name="CommandHint" VerticalAlignment="Bottom" Background="#F0202022" Padding="10,7" Visibility="Collapsed"><TextBlock x:Name="CommandHintText" Text="Bu işlem şu anda kullanılamıyor." FontSize="10" HorizontalAlignment="Center" Foreground="#D2D2D7" /></Border>
        </Grid>
      </Border>
    </StackPanel>
    </Grid>
  </Grid>
</Window>
