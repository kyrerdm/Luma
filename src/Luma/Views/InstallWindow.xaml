<Window x:Class="Luma.Views.InstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma kurulumu" Icon="/Assets/Luma.ico" Width="500" MinHeight="360" MaxHeight="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{DynamicResource BackgroundBrush}"><StackPanel Margin="28">
    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource BrandSymbol}" Width="32" Height="32" Margin="0,0,12,0" /><TextBlock Text="Luma'yı bilgisayarına kur" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
    <TextBlock Text="Başlat menüsüne eklenir ve Windows ayarlarından kaldırılabilir. Mevcut Luma tercihleriniz korunur." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,12" />
    <TextBlock x:Name="InstallPathText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" />
    <CheckBox x:Name="DesktopShortcutToggle" Content="Masaüstüne kısayol ekle" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" FontSize="12" />
    <TextBlock x:Name="InstallStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="InstallNowButton" Content="Kur" Click="InstallNow_Click" /><Button x:Name="LaunchButton" Content="Luma'yı aç" Margin="8,0,0,0" Visibility="Collapsed" Click="Launch_Click" /><Button Content="Kapat" Margin="8,0,0,0" Click="Close_Click" /></StackPanel>
  </StackPanel></Grid>
</Window>
