<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Luma.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <AssemblyName>Luma</AssemblyName>
    <RootNamespace>Luma</RootNamespace>
    <Version>1.0.2</Version>
    <Authors>kyrerdm</Authors>
    <Copyright>Copyright (c) 2026 kyrerdm</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Clean volume, brightness and media flyouts for Windows.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Luma.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Luma.Install.LICENSE.txt" />
    <EmbeddedResource Include="..\..\docs\KULLANIM.txt" LogicalName="Luma.Install.KULLANIM.txt" />
    <EmbeddedResource Include="..\..\docs\WINRT-LICENSE.txt" LogicalName="Luma.Install.WINRT-LICENSE.txt" />
    <EmbeddedResource Include="..\..\docs\WINDOWS-SDK-NOTICE.txt" LogicalName="Luma.Install.WINDOWS-SDK-NOTICE.txt" />
    <EmbeddedResource Include="..\..\docs\distribution\*.txt" LogicalName="Luma.Install.%(Filename)%(Extension)" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <Resource Include="Assets\Luma.ico" />
  </ItemGroup>
</Project>
